{
  "name": "schichtplaner",
  "version": "1.6.1",
  "private": true,
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/resolve-version.js",
    "build": "nuxt build",
    "predev": "node scripts/resolve-version.js && node setup.js",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "nuxt prepare",
    "docs": "node scripts/readme-generator.js",
    "setup-hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "version:check": "node scripts/resolve-version.js && cat .version",
    "changelog": "node scripts/generate-changelog.js"
  },
  "dependencies": {
    "@nuxt/icon": "^2.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@primevue/themes": "^4.2.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "nuxt": "^4.6.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "qrcode": "^1.5.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.13",
    "vue-router": "^5.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.0",
    "@nuxt/test-utils": "^4.0.2",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@primevue/nuxt-module": "^4.2.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.29",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
